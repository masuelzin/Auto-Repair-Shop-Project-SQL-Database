-- Banco de Dados - Oficina Mecânica
-- Cria o banco "oficina_mecanica" no pgAdmin 

-- Apagando as tabelas (caso já existam)
DROP TABLE IF EXISTS ordem_servico_peca;
DROP TABLE IF EXISTS ordem_servico_servico;
DROP TABLE IF EXISTS historico_status;
DROP TABLE IF EXISTS ordem_servico;
DROP TABLE IF EXISTS peca_fornecedor;
DROP TABLE IF EXISTS peca;
DROP TABLE IF EXISTS servico;
DROP TABLE IF EXISTS fornecedor;
DROP TABLE IF EXISTS carro;
DROP TABLE IF EXISTS mecanico;
DROP TABLE IF EXISTS cliente;
DROP TABLE IF EXISTS pessoa;

-- Criando a tabela de Pessoa
CREATE TABLE pessoa (
    cpf             CHAR(11) PRIMARY KEY,
    nome            VARCHAR(100) NOT NULL,
    sexo            CHAR(1),
    data_nascimento DATE,
    telefone        VARCHAR(15),
    endereco        VARCHAR(200),
    CONSTRAINT sexo_valido CHECK (sexo IN ('M', 'F', 'O'))
);

-- Criando a tabela de Cliente
CREATE TABLE cliente (
    cpf           CHAR(11) PRIMARY KEY,
    data_cadastro DATE NOT NULL DEFAULT CURRENT_DATE,
    CONSTRAINT fk_cliente_pessoa FOREIGN KEY (cpf) REFERENCES pessoa (cpf)
        ON UPDATE CASCADE ON DELETE CASCADE
);

-- Criando a tabela de Mecânico
CREATE TABLE mecanico (
    cpf           CHAR(11) PRIMARY KEY,
    especialidade VARCHAR(50),
    salario       DECIMAL(10,2),
    CONSTRAINT salario_positivo CHECK (salario > 0),
    CONSTRAINT fk_mecanico_pessoa FOREIGN KEY (cpf) REFERENCES pessoa (cpf)
        ON UPDATE CASCADE ON DELETE CASCADE
);

-- Criando a tabela de Carro
CREATE TABLE carro (
    placa       VARCHAR(8) PRIMARY KEY,
    modelo      VARCHAR(50) NOT NULL,
    marca       VARCHAR(50) NOT NULL,
    ano         INT CONSTRAINT ano_valido CHECK (ano > 1900),
    cpf_cliente CHAR(11) NOT NULL,
    CONSTRAINT fk_carro_cliente FOREIGN KEY (cpf_cliente) REFERENCES cliente (cpf)
        ON UPDATE CASCADE ON DELETE RESTRICT
);

-- Criando a tabela de Serviço
CREATE TABLE servico (
    codigo_servico INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    descricao      VARCHAR(100) NOT NULL,
    valor_mao_obra DECIMAL(10,2) NOT NULL CONSTRAINT mao_obra_positiva CHECK (valor_mao_obra > 0)
);

-- Criando a tabela de Peça
CREATE TABLE peca (
    codigo_peca INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    descricao   VARCHAR(100) NOT NULL,
    fabricante  VARCHAR(50),
    preco       DECIMAL(10,2) NOT NULL CONSTRAINT preco_peca_positivo CHECK (preco > 0)
);

-- Criando a tabela de Fornecedor
CREATE TABLE fornecedor (
    cnpj          CHAR(14) PRIMARY KEY,
    razao_social  VARCHAR(100) NOT NULL,
    nome_fantasia VARCHAR(100),
    telefone      VARCHAR(15),
    email         VARCHAR(100) UNIQUE,
    endereco      VARCHAR(200)
);

-- Criando a tabela de Peça x Fornecedor
CREATE TABLE peca_fornecedor (
    codigo_peca INT NOT NULL,
    cnpj        CHAR(14) NOT NULL,
    preco_custo DECIMAL(10,2) NOT NULL CHECK (preco_custo > 0),
    PRIMARY KEY (codigo_peca, cnpj),
    CONSTRAINT fk_pf_peca FOREIGN KEY (codigo_peca) REFERENCES peca (codigo_peca)
        ON DELETE CASCADE,
    CONSTRAINT fk_pf_fornecedor FOREIGN KEY (cnpj) REFERENCES fornecedor (cnpj)
        ON DELETE CASCADE
);

-- Criando a tabela de Ordem de Serviço
CREATE TABLE ordem_servico (
    numero_os       INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    data_abertura   DATE NOT NULL DEFAULT CURRENT_DATE,
    data_fechamento DATE,
    status          VARCHAR(20) NOT NULL DEFAULT 'ABERTA',
    valor_total     DECIMAL(10,2) NOT NULL DEFAULT 0,
    placa           VARCHAR(8) NOT NULL,
    cpf_mecanico    CHAR(11) NOT NULL,
    CONSTRAINT status_valido CHECK (status IN ('ABERTA', 'EM_ANDAMENTO', 'AGUARDANDO_PECA', 'FINALIZADA', 'CANCELADA')),
    CONSTRAINT valor_total_valido CHECK (valor_total >= 0),
    CONSTRAINT datas_validas CHECK (data_fechamento >= data_abertura),
    CONSTRAINT fk_os_carro FOREIGN KEY (placa) REFERENCES carro (placa)
        ON UPDATE CASCADE ON DELETE RESTRICT,
    CONSTRAINT fk_os_mecanico FOREIGN KEY (cpf_mecanico) REFERENCES mecanico (cpf)
        ON UPDATE CASCADE ON DELETE RESTRICT
);

-- Criando a tabela de Serviços da Ordem de Serviço
CREATE TABLE ordem_servico_servico (
    numero_os      INT NOT NULL,
    codigo_servico INT NOT NULL,
    quantidade     INT NOT NULL DEFAULT 1 CHECK (quantidade > 0),
    valor_unitario DECIMAL(10,2) NOT NULL CHECK (valor_unitario > 0),
    PRIMARY KEY (numero_os, codigo_servico),
    CONSTRAINT fk_oss_os FOREIGN KEY (numero_os) REFERENCES ordem_servico (numero_os)
        ON DELETE CASCADE,
    CONSTRAINT fk_oss_servico FOREIGN KEY (codigo_servico) REFERENCES servico (codigo_servico)
        ON DELETE RESTRICT
);

-- Criando a tabela de Peças da Ordem de Serviço
CREATE TABLE ordem_servico_peca (
    numero_os      INT NOT NULL,
    codigo_peca    INT NOT NULL,
    quantidade     INT NOT NULL DEFAULT 1 CHECK (quantidade > 0),
    valor_unitario DECIMAL(10,2) NOT NULL CHECK (valor_unitario > 0),
    PRIMARY KEY (numero_os, codigo_peca),
    CONSTRAINT fk_osp_os FOREIGN KEY (numero_os) REFERENCES ordem_servico (numero_os)
        ON DELETE CASCADE,
    CONSTRAINT fk_osp_peca FOREIGN KEY (codigo_peca) REFERENCES peca (codigo_peca)
        ON DELETE RESTRICT
);

-- Criando a tabela de Histórico de Status
CREATE TABLE historico_status (
    numero_os  INT NOT NULL,
    sequencia  INT NOT NULL,
    data_hora  TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    status     VARCHAR(20) NOT NULL,
    observacao VARCHAR(200),
    PRIMARY KEY (numero_os, sequencia),
    CONSTRAINT status_hist_valido CHECK (status IN ('ABERTA', 'EM_ANDAMENTO', 'AGUARDANDO_PECA', 'FINALIZADA', 'CANCELADA')),
    CONSTRAINT fk_hist_os FOREIGN KEY (numero_os) REFERENCES ordem_servico (numero_os)
        ON DELETE CASCADE
);
